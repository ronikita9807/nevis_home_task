# Copy to .env. Docker Compose reads only ANTHROPIC_API_KEY from it (the containers get their own
# DATABASE_URL); the rest is for running the app outside Docker
# (e.g. `uv run uvicorn --factory app.main:create_app`).
# The database from `docker compose up db` is published on localhost:5433.
# A hosted provider's URL (postgresql://…?sslmode=require) works as is: it is converted for asyncpg.
DATABASE_URL=postgresql+asyncpg://nevis:nevis@localhost:5433/nevis

# Shared service key of the trusted caller. Leave empty locally to disable the check.
API_KEY=

LOG_LEVEL=INFO

# Optional: document summaries with Claude. Setting it sends document text to Anthropic.
# Empty = extractive summaries (local only).
ANTHROPIC_API_KEY=
