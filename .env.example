# Copy to .env to run the app outside Docker (e.g. `uv run uvicorn --factory app.main:create_app`).
# The database from `docker compose up db` is published on localhost:5433.
DATABASE_URL=postgresql+asyncpg://nevis:nevis@localhost:5433/nevis

# Shared service key of the trusted caller. Leave empty locally to disable the check.
API_KEY=

LOG_LEVEL=INFO
